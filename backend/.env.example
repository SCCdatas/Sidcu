# ============================================================================
# SIDCU Backend - Variables de entorno
# Copia este archivo como .env en local (NO lo subas a Git).
# En Render: configúralas en Environment del Web Service.
# ============================================================================

# --- Base de datos PostgreSQL (Neon) ---------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/sidcudb
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- Servidor --------------------------------------------------------------
PORT=8080

# --- Aplicación ------------------------------------------------------------
# En producción pon la URL de tu frontend en Render, ej:
# CORS_ALLOWED_ORIGINS=https://sidcu-frontend.onrender.com
CORS_ALLOWED_ORIGINS=*
DDL_AUTO=update
SEED_ENABLED=false
